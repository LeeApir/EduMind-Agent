# Server-only P0 OpenAI-compatible Provider configuration.
# Copy to .env locally; do not commit real values.
EDUMIND_PROVIDER_BASE_URL=https://provider.example/v1
EDUMIND_PROVIDER_API_KEY=replace-with-server-secret
EDUMIND_PROVIDER_MODEL=replace-with-model-id

# PostgreSQL must use the asyncpg driver. Use a separate database for local development.
EDUMIND_DATABASE_URL=postgresql+asyncpg://edumind:replace-with-password@localhost:5432/edumind_dev
