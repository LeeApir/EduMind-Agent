n_failures":0,"caller_head":"t1","cycle_entry":null,"reachable_prefix":[7,4,12],"traversal_status":"terminated","unreachable_allocated_ids":[]}},"spec_digest":"eeb21c66e965277354b6d3b4a38661ec7aa760eb73ef62a2b2ae8923f5933943","template_version":"head-insertion-c-v1","variable_scopes":[{"active_after_return":false,"declaration":"Node *head","name":"head","passing":"pointer_value_copy","scope":"insert.parameter","trace_field":"local_head"},{"active_after_return":false,"declaration":"int value","name":"value","scope":"insert.parameter"},{"active_after_return":false,"declaration":"int allocation_success","name":"allocation_success","scope":"insert.parameter"},{"active_after_return":false,"declaration":"Node *p = allocation_success ? malloc(sizeof *p) : NULL;","name":"p","points_to_storage":"dynamic_on_success","scope":"insert.local"},{"declaration":"Node *caller_head = &i0;","name":"caller_head","scope":"main.local"},{"declaration":"Node i0;","name":"i0","scope":"main.local","storage":"automatic"}]}},"prerequisite_evidence":{"demonstrated_mastery":null,"excerpt":"我已了解 C 指针、struct、NULL 和函数返回值","self_reported":["C 指针","struct","NULL","函数返回值"],"source":"request_1"},"source_binding":{"course_id":"3b616a36-e0c3-4b80-8d60-ee3cff4c053b","operation_id":"cf7da587-ddd0-4eb2-9f44-35a9d9fb4203","request_id":"3b26410c-798c-4394-a4b4-06c028e2d26f"},"unknown_learner_fields":"all others"},"raw_output":{"failure_scope":"本课假定 main 中的分配按给定掩码成功，动画只覆盖成功路径；条件掩码可以强制不分配，但真实 malloc 失败未被动画演示。第 5 行的 if (p == NULL) return head 在失败时会返回旧头，使调用者保持原链表不变，这一分支只作解释，不提供执行或清理动画。本课不证明任意 C 代码的内存安全，也不覆盖 free 的执行过程；关于释放的说明是规则性提醒，而非已演示的步骤。","learning_summary":"头插的核心是三步：分配新节点 p，写 p->data，再写 p->next = head，让新节点的 next 保存旧头指针，从而把新节点接到旧链表前面。insert 内的 head 只是按值传入的副本，作用域限于函数内；函数返回的是新头 p。调用者必须写成 caller_head = insert(...) 接收返回值，caller_head 才会更新为新头；若丢弃返回值，caller_head 仍指向旧头，新分配的动态节点不可达。NULL 检查在成功路径上被跳过，未初始化字段必须先写 data 再写 next 才能安全遍历。","lifecycle":"i0 是 main 的自动存储节点，随 main 的作用域存在，不能 free。t0、t1 是 malloc 得到的动态节点，函数返回后仍然存在，需要由调用者管理。insert 的形参 head、value、allocation_success 与局部 p 都在函数返回后失效，但 p 所指的动态存储不随之消失。若要释放，只能对动态节点调用 free，并且应先保存 next 再 free 当前节点，避免 free 后继续读取该节点；绝不能对 i0 这类栈上节点调用 free。本课不提供清理动画或代码执行，遍历在 NULL 处终止，顺序由追踪给出。","paragraphs":[{"fact_ids":["trace_step_00","trace_step_01"],"text":"先固定示例中的身份：main 里声明了自动存储的节点 i0，i0.data 为 12，i0.next 为 NULL；caller_head 是 main 的局部指针，初值为 &i0。insert 的形参 head 是另一个变量，调用时只是把 caller_head 的指针值复制进去。因此 insert 内部改 head 不会改 caller_head，二者作用域不同：head 只在 insert 内存在，caller_head 只在 main 内存在。"},{"fact_ids":["trace_step_01","trace_step_02"],"text":"第一次调用时，allocation_success 为 1，第 4 行让局部指针 p 指向新分配的动态节点 t0。此时 t0 的 data 与 next 都还是未初始化字段，不能读它们；只有先写 data，再写 next，节点才处于可遍历的完整状态。第 5 行的 if (p == NULL) 检查在分配成功时不成立，所以不会提前 return head，程序继续执行第 6、7 行。"},{"fact_ids":["trace_step_02","trace_step_03","trace_step_04"],"text":"第 6 行 p->data = value 把 4 写入 t0.data。第 7 行 p->next = head 是关键：右边的 head 此刻仍保存旧链表头 i0 的地址，于是 t0.next 指向 i0。这一步并没有修改 i0，也没有修改 caller_head；它只是让新节点 t0 的 next 保存旧头指针，从而把 t0 接到旧链表前面。第 8 行 return p 返回的是 t0 的地址，而不是 head。"},{"fact_ids":["trace_step_05"],"text":"回到 main 的第 15 行，调用写成 caller_head = insert(caller_head, 4, 1)。赋值把返回值 t0 存回 caller_head，于是 caller_head 从 i0 变为 t0，链表头更新为 t0，可达顺序是 t0→i0。若这里丢弃返回值，caller_head 仍是 i0，t0 虽然已分配且 t0.next 指向 i0，但从 caller_head 出发无法到达 t0，新节点就不可达了。"},{"fact_ids":["trace_step_06","trace_step_07","trace_step_08","trace_step_09","trace_step_10"],"text":"第二次调用时，传入的 head 副本是 t0，所以 insert 内的 head 与 caller_head 此刻值相同但仍是不同变量。第 4 行分配 t1，第 6 行写入 7，第 7 行 p->next = head 让 t1.next 指向 t0，第 8 行返回 t1。第 16 行 caller_head = insert(...) 把 t1 存回 caller_head，最终可达顺序为 t1→t0→i0，数据依次是 7、4、12，遍历在 i0.next 为 NULL 处终止。"},{"fact_ids":["trace_step_01","trace_step_06"],"text":"关于 NULL 检查：第 5 行的 if (p == NULL) return head 在分配成功时被跳过，这正是本例两次调用的情况。它的意义是分配失败时直接返回旧头，让调用者保持原链表不变；但本课的动画只覆盖成功分配，不演示真实 malloc 失败，也不演示失败分支的执行。理解这一点即可，不要把“检查通过”误解为“检查不存在”。"},{"fact_ids":["trace_step_01","trace_step_02","trace_step_03"],"text":"关于未初始化字段：t0 刚分配时 data 与 next 都是不确定值，必须先写 data 再写 next，才能安全遍历。若在写 next 之前就遍历，next 的垃圾值会导致未定义行为。本例的追踪显示写 data 后 next 仍不确定，写 next 后才完整，这说明字段初始化顺序与节点可用性是两件事。"}],"prerequisites":"你自述已了解 C 指针、struct、NULL 和函数返回值。本课把这些当作起点，但不会假定你已经掌握按值传参的细节、局部变量的作用域与生存期、动态分配与自动存储的区别。若某处感到跳跃，请回到对应段落重读变量身份与箭头方向。","questions":{"discarded_values":{"explanation":"返回值被丢弃，caller_head 仍为 &i0，因此从 i0 出发只能读到 30、40；新分配的 t0 虽然存在且 t0.next=i0，但从 caller_head 不可达。","stem":"考虑如下 C 代码：\n\n#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nNode *insert(Node *head, int value, int allocation_success) {\n    Node *p = allocation_success ? malloc(sizeof *p) : NULL;\n    if (p == NULL) return head;\n    p->data = value;\n    p->next = head;\n    return p;\n}\nint main(void) {\n    Node i0;\n    Node i1;\n    i0.data = 30;\n    i0.next = &i1;\n    i1.data = 40;\n    i1.next = NULL;\n    Node *caller_head = &i0;\n    insert(caller_head, 11, 1);\n    (void)caller_head;\n    return 0;\n}\n\n若调用处丢弃返回值（如上写 insert(caller_head, 11, 1); 而不赋值），从 main 的 caller_head 出发沿 next 遍历直到 NULL，依次读到的 data 值是什么？请用一个 JSON 整数数组作答。"},"link_target":{"explanation":"调用时 head 副本保存的是 caller_head 的当前值 &i0，所以 p->next = head 让新节点 t0 的 next 指向 i0。i1 是 i0 的后继，不是这一步的直接目标。","stem":"考虑如下 C 代码：\n\n#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nNode *insert(Node *head, int value, int allocation_success) {\n    Node *p = allocation_success ? malloc(sizeof *p) : NULL;\n    if (p == NULL) return head;\n    p->data = value;\n    p->next = head;\n    return p;\n}\nint main(void) {\n    Node i0;\n    Node i1;\n    i0.data = 30;\n    i0.next = &i1;\n    i1.data = 40;\n    i1.next = NULL;\n    Node *caller_head = &i0;\n    caller_head = insert(caller_head, 11, 1);\n    (void)caller_head;\n    return 0;\n}\n\n在正常代码路径下，insert 执行到 p->next = head 时，p->next 第一次被赋成的目标节点是哪一个？请只填写该初始节点的 C 变量名（不要加 & 或说明文字）。"},"normal_values":{"explanation":"caller_head 被赋值为返回的新节点 t0，t0.data=11、t0.next=i0，i0.data=30、i0.next=&i1，i1.data=40、i1.next=NULL，因此顺序为 11、30、40。","stem":"考虑如下 C 代码：\n\n#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nNode *insert(Node *head, int value, int allocation_success) {\n    Node *p = allocation_success ? malloc(sizeof *p) : NULL;\n    if (p == NULL) return head;\n    p->data = value;\n    p->next = head;\n    return p;\n}\nint main(void) {\n    Node i0;\n    Node i1;\n    i0.data = 30;\n    i0.next = &i1;\n    i1.data = 40;\n    i1.next = NULL;\n    Node *caller_head = &i0;\n    caller_head = insert(caller_head, 11, 1);\n    (void)caller_head;\n    return 0;\n}\n\n在正常代码路径下，从 main 的 caller_head 出发沿 next 遍历直到 NULL，依次读到的 data 值是什么？请用一个 JSON 整数数组作答。"},"unreachable_count":{"explanation":"本次调用只分配了一个动态节点 t0；返回值被丢弃后 caller_head 仍为 &i0，t0 不在从 caller_head 出发的可达链上，因此不可达的动态节点数为 1。i0 与 i1 是自动存储节点，不计入动态分配节点。","stem":"考虑如下 C 代码：\n\n#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nNode *insert(Node *head, int value, int allocation_success) {\n    Node *p = allocation_success ? malloc(sizeof *p) : NULL;\n    if (p == NULL) return head;\n    p->data = value;\n    p->next = head;\n    return p;\n}\nint main(void) {\n    Node i0;\n    Node i1;\n    i0.data = 30;\n    i0.next = &i1;\n    i1.data = 40;\n    i1.next = NULL;\n    Node *caller_head = &i0;\n    insert(caller_head, 11, 1);\n    (void)caller_head;\n    return 0;\n}\n\n若调用处丢弃返回值（如上写 insert(caller_head, 11, 1); 而不赋值），从 main 的 caller_head 出发，有多少个动态分配的节点不可达？请用一个 JSON 整数作答。"}},"step_notes":[{"frame_id":"f00","note":"main 中 i0.data=12、i0.next=NULL，caller_head 指向 i0。insert 尚未调用，局部 head 与 p 都不存在，作用域仅在 main。","title":"初始状态：只有自动节点 i0"},{"frame_id":"f01","note":"allocation_success 为 1，malloc 返回新动态节点 t0，局部 p 指向 t0。t0 的 data 与 next 仍是未初始化字段，不能读取。head 副本仍为 i0。","title":"第 4 行：分配 t0，p 指向它"},{"frame_id":"f02","note":"p 不为 NULL，if (p == NULL) return head 不成立，不提前返回。此帧只表示检查通过，不表示发生过分配失败。","title":"第 5 行：NULL 检查通过"},{"frame_id":"f03","note":"p->data = value 把 4 写入 t0.data。t0.next 仍不确定，节点还不能安全遍历。caller_head 与 head 都仍指向 i0。","title":"第 6 行：写入 t0.data=4"},{"frame_id":"f04","note":"p->next = head 把旧头指针 i0 存入 t0.next，新节点接到旧链表前面。i0 与 caller_head 都未被修改。","title":"第 7 行：t0.next 指向旧头 i0"},{"frame_id":"f05","note":"return p 返回 t0 的地址。insert 即将结束，局部 head 与 p 的作用域随之结束，但 t0 是动态存储，仍然存在。","title":"第 8 行：返回 t0"},{"frame_id":"f06","note":"caller_head = insert(...) 把 t0 存回 caller_head，链表头从 i0 变为 t0。若丢弃返回值，caller_head 仍为 i0，t0 将不可达。","title":"第 15 行：caller_head 接收返回值"},{"frame_id":"f07","note":"传入的 head 副本为 t0，malloc 返回 t1，局部 p 指向 t1。t1 的 data 与 next 未初始化，head 仍为 t0。","title":"第 4 行：第二次分配 t1"},{"frame_id":"f08","note":"p 不为 NULL，不提前返回 head。此帧同样只表示成功路径上的检查通过。","title":"第 5 行：第二次 NULL 检查通过"},{"frame_id":"f09","note":"p->data = value 把 7 写入 t1.data。t1.next 仍不确定，尚未接入链表。","title":"第 6 行：写入 t1.data=7"},{"frame_id":"f10","note":"p->next = head 把当前旧头 t0 存入 t1.next，t1 接到 t0 前面。caller_head 此刻仍为 t0，尚未更新。","title":"第 7 行：t1.next 指向旧头 t0"},{"frame_id":"f11","note":"return p 返回 t1。insert 结束，局部 head 与 p 失效；t1 是动态节点，继续存在。","title":"第 8 行：返回 t1"},{"frame_id":"f12","note":"caller_head = insert(...) 把 t1 存回 caller_head，最终可达顺序 t1→t0→i0，数据 7、4、12，遍历在 NULL 处终止。","title":"第 16 行：caller_head 更新为 t1"}]}},"protocol_version":"head-f01-f02-four-text-v1","review":{"candidate_digest":"7fde0859549aef0e0e64415880ed67e541dbf3f0d302e7eeae6faf76090b0779","evaluated_at":"2026-11-04T15:25:09+08:00","findings":[{"assembled_paths":["blocks[text-2].markdown","blocks[text-7].markdown","blocks[text-12].markdown","blocks[head-state].text_alternative"],"category":"fact","id":"F01","impact":"把本例代码顺序误说成 C 语义的必要条件。对有效已分配节点，先 p->next=head 再 p->data=value，同样可在两字段就绪后安全读取；仅沿 next 遍历而不读 data 时，也不要求先写 data。实际轨迹顺序正确不证明该必要性陈述。","path":"candidate.raw_output.paragraphs[6].text","quote":"必须先写 data 再写 next，才能安全遍历。","related_quotes":["只有先写 data，再写 next，节点才处于可遍历的完整状态。","未初始化字段必须先写 data 再写 next 才能安全遍历。"],"severity":"blocking"},{"assembled_paths":["blocks[text-12].markdown","blocks[head-state].text_alternative"],"category":"step_consistency","id":"F02","impact":"第5行条件在成功路径实际被求值且为假