        "text": "#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nNode *insert(Node *head, int value, int allocation_success) {\n    Node *p = allocation_success ? malloc(sizeof *p) : NULL;\n    if (p == NULL) return head;\n    p->data = value;\n    p->next = head;\n    return p;\n}\nint main(void) {\n    Node *caller_head = NULL;\n    caller_head = insert(caller_head, 7, 1);\n    (void)caller_head;\n    return 0;\n}\n",
        "value_digest": "02d23d57d9a7e8985a9a6ccacb6603578b8d72de407325b124207963dda3316c",
        "value_type": "str"
