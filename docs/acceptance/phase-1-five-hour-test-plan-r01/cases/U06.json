          "resource_type": "code",
          "prompt_version": "learning-resources-v1",
          "content": {
            "language": "C",
            "source": "int sum_sample(void) {\n    int a[3] = {4, 6, 9};\n    int s = 0;\n    for (int i = 0; i < 3; ++i) s += a[i];\n    return s;\n}",
            "expected_output": "函数返回19，没有标准输出。",
            "key_steps": [
              "初始s=0；i=0轮后s=4，i=1轮后s=10，i=2轮后s=19；随后i=3，3<3为假，退出，不访问a[3]，返回19，无打印。"
            ],
            "display_only": true
          }
