ocal_head":null,"nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null}},"p":null,"phase":"initial","returned":null},{"attempt":0,"caller_head":"i0","code_line":4,"local_head":"i0","nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null},"t0":{"data":"indeterminate","next":"indeterminate"}},"p":"t0","phase":"allocate","returned":null},{"attempt":0,"caller_head":"i0","code_line":6,"local_head":"i0","nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null},"t0":{"data":11,"next":"indeterminate"}},"p":"t0","phase":"data","returned":null},{"attempt":0,"caller_head":"i0","code_line":7,"local_head":"i0","nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null},"t0":{"data":11,"next":"i0"}},"p":"t0","phase":"link","returned":null},{"attempt":0,"caller_head":"i0","code_line":8,"local_head":"i0","nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null},"t0":{"data":11,"next":"i0"}},"p":"t0","phase":"return","returned":"t0"},{"attempt":0,"caller_head":"t0","code_line":18,"local_head":"i0","nodes":{"i0":{"data":30,"next":"i1"},"i1":{"data":40,"next":null},"t0":{"data":11,"next":"i0"}},"p":"t0","phase":"caller","returned":"t0"}]}}},"version":"head-goal-course-v1"},"original_goal":"我已了解 C 指针、struct、NULL 和函数返回值，希望通过头插示例，理解新节点如何连接旧链表，以及为什么调用者需要接收函数返回值。 本次明确使用 head-new-B：初始链表 [-8]，依次插入 6、0。","plan":{"conventions":["统一使用 head-new-B：初始链表 [-8]，依次插入 6、0，两次 malloc 均成功（allocation_success 为 1）。","代码语言为 C，函数接口固定为 Node *insert(Node *head, int value, int allocation_success)。","区分两个变量：insert 的局部参数 head 与 main 的 caller_head；二者是不同变量，head 只是指针值的副本。","节点用标识表示：i0 为初始节点（数据 -8），t0、t1 为两次插入新分配的节点。","接收返回值时最终可达序列为 [0, 6, -8]；忽略返回值时可达序列仍为 [-8]，t0、t1 不可达。","本课为单场景，包含 text、code、visualization、exercise 四种形式，学习时长约 15 分钟。"],"objectives":[{"description":"能追踪 insert 中 p->next = head 这一步：局部参数 head 保存的是旧链表首节点地址的副本，因此新节点 p 的 next 指向旧链表首节点，新节点由此与旧链表连接。","id":"obj-link-old-list","source":"user_requirement","source_excerpt":"理解新节点如何连接旧链表","source_key":"request_1"},{"description":"能说明为什么调用者必须接收 insert 的返回值：函数返回新首节点 p，只有执行 caller_head = insert(...) 才能让 caller_head 指向新首节点；若忽略返回值，caller_head 仍指向旧首节点，新分配的节点不可达。","id":"obj-receive-return","source":"user_requirement","source_excerpt":"为什么调用者需要接收函数返回值","source_key":"request_1"}],"scenes":[{"depends_on":[],"forms":["text","code","visualization","exercise"],"objective_ids":["obj-link-old-list","obj-receive-return"],"purpose":"借助 head-new-B 的代码与追踪，先讲清 p->next = head 如何让新节点连接旧链表（局部 head 是 caller_head 的副本），再对比接收与忽略返回值两种调用：接收时 caller_head 依次变为 t0、t1，可达序列 [0, 6, -8]；忽略时 caller_head 始终为 i0，可达序列仍为 [-8]，t0、t1 不可达。最后通过练习巩固这两点。","scene_key":"scene-head-insert","title":"头插全过程：连接旧链表与接收返回值"}],"shared_example":"head-new-B","terminology":[{"meaning":"main 中的局部指针变量，初始为 &i0，指向首节点 -8；它是调用者持有的链表入口。","term":"caller_head"},{"meaning":"insert 的形参，按值接收 caller_head 的指针副本；函数内修改 head 本身不会改变 caller_head。","term":"head（insert 参数）"},{"meaning":"insert 的局部指针，malloc 成功后指向新分配的节点，用于存放 value 并链接旧链表。","term":"p"},{"meaning":"把新节点 p 的 next 指向当前旧链表首节点，使新节点与旧链表连接。","term":"p->next = head"},{"meaning":"函数把新首节点地址返回给调用者。","term":"return p"},{"meaning":"调用者写成 caller_head = insert(caller_head, value, 1)，用返回值更新自己的入口指针。","term":"接收返回值"},{"meaning":"调用者写成 insert(caller_head, value, 1)，返回值被丢弃，caller_head 不变，新分配节点不可达。","term":"忽略返回值"}],"title":"头插法：连接旧链表与接收返回值（head-new-B）"},"planning_basis":{"binding":{"basis_digest":"dbfa7a38e73cf8cb36df518485019556bce56a23fc7d25dd1f18fbe0f3a28899","example_basis_digest":"0360ade8fa9999d6bd2d2b5d8994c135c622ffbc0b4d4d0311ee281bdf9b6882","materials_digest":"9aeb6bcf2208528af1d5ed7c8b9906b47fdb8a5fa8247e7798eceed62a0e9012","selected_example":"head-new-B","version":"head-planning-example-basis-v1"},"evidence":{"assumptions":{"actual_malloc_assumed_success":true,"actual_malloc_failure_animated":false,"allocation_success":[true,true],"c_executed":false,"cleanup_animated":false},"code_digest":"50f646a84e945e8d50937a90d9fdc66f4a6ea13c92863feab26a888947a3d8f4","engine_version":"head-insertion-engine-v2","examp