        "envelope": {
          "resource_type": "code",
          "prompt_version": "learning-resources-v1",
          "content": {
            "language": "C",
            "source": "#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nvoid free_list(Node **head) { Node *p=*head; while(p) { Node *q=p->next; free(p); p=q; } *head=NULL; }\nint main(void) { Node *head=malloc(sizeof *head); if(!head) return 0; head->data=4; head->next=NULL; free_list(&head); if(head) free(head); return 0; }",
            "expected_output": "不包含打印语句；不主张未定义行为有确定返回值。",
            "key_steps": [
              "free_list接收Node **，释放后*head=NULL；main传&head，故清空调用方head。if(head)为假，不二次释放。"
            ],
            "display_only": true
          }
        },
