        "envelope": {
          "resource_type": "code",
          "prompt_version": "learning-resources-v1",
          "content": {
            "language": "C",
            "source": "#include <stdlib.h>\ntypedef struct Node { int data; struct Node *next; } Node;\nvoid free_list(Node *head) { Node *p=head; while(p) { Node *q=p->next; free(p); p=q; } head=NULL; }\nint main(void) { Node *head=malloc(sizeof *head); if(!head) return 0; head->data=4; head->next=NULL; free_list(head); free(head); return 0; }",
            "expected_output": "不包含打印语句；不主张未定义行为有确定返回值。",
            "key_steps": [
              "本例声称free_list中的head=NULL也会清空main的head，因此再次free(head)安全。"
            ],
            "display_only": true
          }
        },
