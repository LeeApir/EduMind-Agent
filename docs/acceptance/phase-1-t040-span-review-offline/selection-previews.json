        {
          "requires_disposition": false,
          "span_id": "s0059",
          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0060",
          "text": "bool queue_is_full(const Queue *q) {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0061",
          "text": "    return q->size == CAPACITY;\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0062",
          "text": "}\n"
        },
