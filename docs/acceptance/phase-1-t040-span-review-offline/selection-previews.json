          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0064",
          "text": "/* 入队：成功返回 true，队列已满返回 false */\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0065",
          "text": "bool enqueue(Queue *q, int value) {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0066",
          "text": "    if (queue_is_full(q)) {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0067",
          "text": "        return false;\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0068",
          "text": "    }\n"
        },
        {
          "requires_disposition": true,
