          "text": "    int size;    /* 当前元素个数 */\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0048",
          "text": "} Queue;\n"
        },
        {
          "requires_disposition": false,
          "span_id": "s0049",
          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0050",
          "text": "void queue_init(Queue *q) {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0051",
          "text": "    q->front = 0;\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0052",
          "text": "    q->rear = 0;\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0053",
