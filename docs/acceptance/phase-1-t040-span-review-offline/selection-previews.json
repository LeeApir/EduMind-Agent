        },
        {
          "requires_disposition": false,
          "span_id": "s0042",
          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0043",
          "text": "typedef struct {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0044",
          "text": "    int data[CAPACITY];\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0045",
          "text": "    int front;   /* 队头下标 */\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0046",
          "text": "    int rear;    /* 下一个空位下标 */\n"
        },
        {
          "requires_disposition": true,
