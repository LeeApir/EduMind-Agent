          "span_id": "s0055",
          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0056",
          "text": "bool queue_is_empty(const Queue *q) {\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0057",
          "text": "    return q->size == 0;\n"
