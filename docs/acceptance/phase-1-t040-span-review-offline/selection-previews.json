        {
          "requires_disposition": true,
          "span_id": "s0075",
          "text": "/* 出队：成功时把值写入 *out 并返回 true；空队列返回 false */\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0076",
          "text": "bool dequeue(Queue *q, int *out) {\n"
