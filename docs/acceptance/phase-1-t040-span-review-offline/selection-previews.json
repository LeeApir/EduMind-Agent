          "text": "\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0036",
          "text": "```c\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0037",
          "text": "#include <stdio.h>\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0038",
          "text": "#include <stdlib.h>\n"
        },
        {
          "requires_disposition": true,
          "span_id": "s0039",
