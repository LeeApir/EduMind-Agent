{
  "schema_version": "animation-dsl/1",
  "knowledge_point_id": "arrays",
  "language": "zh-CN",
  "title": "两个节点的数值比较与交换（动作契约示例）",
  "pointers": [
    {
      "id": "p",
      "label": "p"
    }
  ],
  "actions": [
    {
      "op": "create_node",
      "id": "n0",
      "value": 3,
      "column": 1,
      "row": 1,
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "建立值为3的节点"
    },
    {
      "op": "create_node",
      "id": "n1",
      "value": 1,
      "column": 3,
      "row": 1,
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "建立值为1的节点"
    },
    {
      "op": "connect",
      "id": "e0",
      "source": "n0",
      "target": "n1",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "建立n0到n1的有向连接"
    },
    {
      "op": "move_pointer",
      "pointer": "p",
      "target": "n0",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "指针p指向n0"
    },
    {
      "op": "highlight",
      "object": "n0",
      "style": "focus",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "突出显示n0"
    },
    {
      "op": "compare",
      "left": "n0",
      "right": "n1",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "比较当前节点数值：3大于1"
    },
    {
      "op": "swap",
      "left": "n0",
      "right": "n1",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "仅交换数值，节点身份和连接保持不变"
    },
    {
      "op": "visit",
      "node": "n1",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "访问并标记n1"
    },
    {
      "op": "disconnect",
      "edge": "e0",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "移除e0连接"
    },
    {
      "op": "move_pointer",
      "pointer": "p",
      "target": null,
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "指针p回到NULL"
    },
    {
      "op": "show_complexity",
      "time": "O(1)",
      "space": "O(1)",
      "duration_ms": 1000,
      "hold_ms": 1800,
      "caption": "此固定规模交换两个值的步骤使用常数时间与额外空间"
    }
  ]
}
