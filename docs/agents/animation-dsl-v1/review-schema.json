{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_version",
    "verdict",
    "issues"
  ],
  "properties": {
    "review_version": {
      "const": "animation-dsl-review-v1"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "reject"
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "severity",
          "action_index",
          "message"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "reference",
              "fact",
              "complexity",
              "caption",
              "difficulty",
              "safety"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "major",
              "severe"
            ]
          },
          "action_index": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 119
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
