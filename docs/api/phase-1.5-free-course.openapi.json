  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edumind_session"
      }
    },
    "parameters": {
      "CourseId": {
        "name": "course_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Version": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "SceneId": {
        "name": "scene_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "Csrf": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "Key": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "schemas": {
      "CreateCourse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "teaching_language": {
            "type": "string",
            "enum": [
              "zh-CN"
            ],
            "default": "zh-CN"
          },
          "code_language": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "c",
              null
            ],
            "default": "c"
          }
        },
        "required": [
          "goal"
        ]
      },
      "CreatedCourse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "course_id",
          "operation_id"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "NodeLink": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scene_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "graph_version": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "target",
              "supporting"
            ]
          },
          "source": {
            "enum": [
              "user_selected",
              "planner_suggestion"
            ]
          }
        },
        "required": [
          "scene_id",
          "node_id",
          "graph_version",
          "relation",
          "source"
        ]
      },
      "SceneBinding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scene_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "scene_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scene_id",
          "title",
          "scene_version_id"
        ]
      },
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean"
          },
          "scenes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SceneBinding"
            }
          },
          "node_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeLink"
            }
          }
        },
        "required": [
          "course_id",
          "version",
          "plan_id",
          "created_at",
          "complete",
          "scenes",
          "node_links"
        ]
      },
      "Course": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "string",
            "format": "uuid"
          },
          "original_goal": {
            "type": "string"
          },
          "teaching_language": {
            "enum": [
              "zh-CN"
            ]
          },
          "code_language": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "c",
              null
            ]
          },
          "course_kind": {
            "const": "ai_draft"
          },
          "endorsement": {
            "const": "unendorsed"
          },
          "head": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Manifest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "course_id",
          "original_goal",
          "teaching_language",
          "code_language",
          "course_kind",
          "endorsement",
          "head"
        ]
      },
      "CourseSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "string",
            "format": "uuid"
          },
          "original_goal": {
            "type": "string"
          },
          "course_kind": {
            "const": "ai_draft"
          },
          "endorsement": {
            "const": "unendorsed"
          },
          "head_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "course_id",
          "original_goal",
          "course_kind",
          "endorsement",
          "head_version",
          "created_at"
        ]
      },
      "VersionSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "version",
          "created_at"
        ]
      },
      "TextBlock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "text"
          },
          "anchor_id": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "anchor_id",
          "markdown"
        ]
      },
      "CodeBlock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "code"
          },
          "anchor_id": {
            "type": "string"
          },
          "language": {
            "const": "c"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "anchor_id",
          "language",
          "source"
        ]
      },
      "ExerciseBlock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "exercise"
          },
          "anchor_id": {
            "type": "string"
          },
          "exercise_id": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "anchor_id",
          "exercise_id",
          "question"
        ]
      },
      "Scene": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "string",
            "format": "uuid"
          },
          "course_version": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string",
            "format": "uuid"
          },
          "scene_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/CodeBlock"
                },
                {
                  "$ref": "#/components/schemas/ExerciseBlock"
                }
              ]
            }
          }
        },
        "required": [
          "course_id",
          "course_version",
          "scene_id",
          "scene_version_id",
          "blocks"
        ]
      },
      "CourseList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
