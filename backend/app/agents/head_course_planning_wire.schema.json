{
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "needs_clarification", "plans", "questions", "reason", "source_keys"],
  "properties": {
    "protocol_version": {"type": "string", "enum": ["head-goal-planning-wire-v2"]},
    "needs_clarification": {"type": "boolean"},
    "plans": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "objectives", "shared_example", "terminology", "conventions", "scenes"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 2000},
          "shared_example": {"type": "string", "minLength": 1, "maxLength": 2000},
          "objectives": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "description", "source", "source_key", "source_excerpt"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 64},
                "description": {"type": "string", "minLength": 1, "maxLength": 2000},
                "source": {"type": "string", "enum": ["user_requirement", "planner_suggestion"]},
                "source_key": {"type": "string", "maxLength": 2000},
                "source_excerpt": {"type": "string", "maxLength": 2000}
              }
            }
          },
          "terminology": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["term", "meaning"],
              "properties": {
                "term": {"type": "string", "minLength": 1, "maxLength": 100},
                "meaning": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          },
          "conventions": {
            "type": "array", "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "scenes": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["scene_key", "title", "purpose", "forms", "objective_ids", "depends_on"],
              "properties": {
                "scene_key": {"type": "string", "minLength": 1, "maxLength": 64},
                "title": {"type": "string", "minLength": 1, "maxLength": 2000},
                "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
                "forms": {
                  "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
                  "items": {"type": "string", "enum": ["text", "code", "exercise", "visualization"]}
                },
                "objective_ids": {
                  "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 64}
                },
                "depends_on": {
                  "type": "array", "maxItems": 7, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              }
            }
          }
        }
      }
    },
    "questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "reason": {"type": "string", "enum": ["", "requirements_conflict", "required_material_missing", "out_of_scope"]},
    "source_keys": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
  }
}
