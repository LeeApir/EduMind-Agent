{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/TextBlock"
          },
          {
            "$ref": "#/$defs/CodeBlock"
          },
          {
            "$ref": "#/$defs/PrivateExerciseBlock"
          },
          {
            "$ref": "#/$defs/VisualizationBlock"
          }
        ]
      },
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "text"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Action"
      }
    }
  },
  "required": [
    "blocks",
    "actions"
  ],
  "$defs": {
    "TextBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "anchor_id",
        "markdown"
      ]
    },
    "CodeBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "code"
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "language": {
          "const": "c"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor_id",
        "language",
        "source"
      ]
    },
    "VisualElement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "next_id": {
          "maxLength": 64,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "next_id"
      ]
    },
    "VisualStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caption": {
          "type": "string",
          "maxLength": 1000
        },
        "elements": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/VisualElement"
          }
        },
        "highlight_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "caption",
        "elements",
        "highlight_ids"
      ]
    },
    "VisualizationBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "visualization"
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "visualization_type": {
          "enum": [
            "array",
            "linked_list",
            "stack",
            "queue"
          ]
        },
        "text_alternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/VisualStep"
          }
        }
      },
      "required": [
        "kind",
        "anchor_id",
        "visualization_type",
        "text_alternative",
        "steps"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "highlight_block",
            "show_step",
            "pause"
          ]
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "step_index": {
          "minimum": 0,
          "maximum": 49,
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "anchor_id",
        "step_index"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "show_step"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "step_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 49
              }
            }
          },
          "else": {
            "properties": {
              "step_index": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PrivateQuestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input_type": {
          "const": "short_text"
        },
        "answer_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "solution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "question_id",
        "question",
        "input_type",
        "answer_key",
        "solution"
      ]
    },
    "PrivateExerciseBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/PrivateQuestion"
          }
        },
        "exercise_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "anchor_id",
        "question",
        "items",
        "exercise_key"
      ]
    }
  }
}
